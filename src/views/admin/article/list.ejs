<%- include("../../layouts/main-top.ejs") %>
<div>
    <div class="my-4">
        <a href="/admin/article/create" class="text-blue-600 underline" > Create new article</a>
    </div>
    <table class="border-collapse border border-gray-400 w-full">
        <thead>
            <tr>
                <th class="border border-gray-300 px-4 py-2">Id</th>
                <th class="border border-gray-300 px-4 py-2">Title</th>
            </tr>
        </thead>
        <tbody>
        <% for (const article of articles) {%> 
            <tr>
                <td class="border border-gray-300 px-4 py-2 text-center"><%= article.id%></td>
                <td class="border border-gray-300 px-4 py-2 text-center"><%= article.title%></td>
            </tr>
    <%} %>
        </tbody>
    </table>
</div>
<%- include("../../layouts/main-bottom.ejs") %>