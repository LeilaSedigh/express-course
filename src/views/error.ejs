<%- include("./layouts/main-top.ejs") %>

<div class="mx-auto w-full max-w-2xl py-6 sm:py-10">
  <div class="rounded-2xl border border-red-100 bg-red-50 p-6 sm:p-8">
    <p class="mb-2 text-sm font-semibold text-red-600">
      Something went wrong
    </p>

    <h2 class="text-xl font-bold text-slate-900 sm:text-2xl">
      We couldn’t complete your request
    </h2>

    <p class="mt-3 text-sm leading-7 text-slate-600 break-words">
      <%= content %>
    </p>

    <a
      href="/"
      class="mt-6 inline-flex h-11 items-center justify-center rounded-lg bg-blue-600 px-5 text-sm font-semibold text-white transition-colors hover:bg-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
    >
      Back to home
    </a>
  </div>

  <% if (locals.stack) { %>
    <details class="mt-5 overflow-hidden rounded-xl border border-slate-200">
      <summary
        class="cursor-pointer bg-slate-50 px-5 py-4 text-sm font-medium text-slate-600 focus-visible:outline-2 focus-visible:outline-blue-600"
      >
        Technical details
      </summary>

      <pre
        class="max-h-80 overflow-auto bg-slate-900 p-5 text-left text-xs leading-6 text-slate-300"
        dir="ltr"
      ><code><%= locals.stack %></code></pre>
    </details>
  <% } %>
</div>

<%- include("./layouts/main-bottom.ejs") %>
