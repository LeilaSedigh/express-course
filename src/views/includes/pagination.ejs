<% if (pages > 1) { %>
  <nav aria-label="Pagination" class="mt-6">
    <ul class="flex flex-wrap items-center justify-center gap-2">
      <% for (let i = 1; i <= pages; i++) { %>
        <% const isActive = i === Number(page); %>

        <li>
          <a
            href="?page=<%= i %>"
            <% if (isActive) { %>aria-current="page"<% } %>
            aria-label="Page <%= i %>"
            class="inline-flex h-10 min-w-10 items-center justify-center rounded-lg border px-3 text-sm font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 <%= isActive
              ? 'border-blue-600 bg-blue-600 text-white shadow-sm'
              : 'border-slate-200 bg-white text-slate-600 hover:border-blue-300 hover:bg-blue-50 hover:text-blue-600' %>"
          >
            <%= i %>
          </a>
        </li>
      <% } %>
    </ul>
  </nav>
<% } %>
