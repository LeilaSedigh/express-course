<%- include("../layouts/main-top.ejs") %>

<div class="flex flex-col gap-6">
  <% if (items.length > 0) { %>
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
    <% for (const article of items) { %>
    <article class="group flex min-w-0 flex-col overflow-hidden rounded-xl border border-slate-200 bg-white transition duration-200 hover:border-blue-200 hover:shadow-md">
      <div class="aspect-video overflow-hidden bg-slate-100">
        <% if (article.image) { %>
        <img src="<%= article.image %>" alt="<%= article.title %>" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-300 motion-safe:group-hover:scale-105" />
        <% } else { %>
        <div class="flex h-full items-center justify-center text-sm text-slate-400">
          No image available
        </div>
        <% } %>
      </div>

      <div class="flex flex-1 flex-col p-5">
        <h2 class="text-lg font-semibold leading-7 text-slate-900 break-words">
          <%= article.title %>
        </h2>
      </div>
    </article>
    <% } %>
  </div>

  <%- include("../includes/pagination.ejs") %>
  <% } else { %>
  <div class="flex flex-col items-center justify-center rounded-xl border border-dashed border-slate-300 bg-slate-50 px-6 py-16 text-center">
    <h2 class="text-lg font-semibold text-slate-800">
      No articles yet
    </h2>

    <p class="mt-2 text-sm leading-6 text-slate-500">
      Articles will appear here once they are published.
    </p>
  </div>
  <% } %>
</div>

<%- include("../layouts/main-bottom.ejs") %>